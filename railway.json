{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "alembic upgrade head && python -m apps.api.rag.ingest_cli data/knowledge"
    ],
    "startCommand": "/bin/sh -c \"alembic upgrade head && exec uvicorn apps.api.main:app --host 0.0.0.0 --port $PORT\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
