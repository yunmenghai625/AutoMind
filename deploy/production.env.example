APP_ENV=production
DATABASE_URL=${{pgvector.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_SECRET=replace-with-environment-secret-at-least-32-characters
JWT_AUDIENCE=authenticated
JWT_ISSUER=
ADMIN_USERNAME=yunmenghai625
# Generate interactively: python -m apps.api.auth.admin_cli
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HOURS=8
VIN_HASH_SECRET=replace-with-different-secret-at-least-32-characters
CORS_ORIGINS=https://app.example.com
DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
AI_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_CONCURRENCY=4
AI_LEASE_SECONDS=120
REQUEST_TIMEOUT_SECONDS=30
OPERATIONAL_METRICS_TIMEOUT_SECONDS=1
LOAD_TEST_TOKEN=replace-with-production-load-test-secret
OTEL_ENABLED=true
OTEL_SERVICE_NAME=automind-api-production
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.example.com
OTEL_EXPORTER_OTLP_HEADERS=Authorization=replace-with-otel-secret
DAILY_AI_BUDGET_CNY=0.6
BUDGET_ECONOMY_THRESHOLD_RATIO=0.8
USAGE_QUOTA_ENABLED=true
VEHICLE_DATA_PROVIDER=disabled
AIGC_ASSET_STORAGE=s3
DIAGNOSIS_ASSET_STORAGE=s3
R2_ENDPOINT=https://replace-with-r2-endpoint
AIGC_R2_BUCKET=automind-production
DIAGNOSIS_R2_BUCKET=automind-production
R2_ACCESS_KEY=replace-with-secret
R2_SECRET_KEY=replace-with-secret
R2_PUBLIC_BASE_URL=
