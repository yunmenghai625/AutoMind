# AutoMind Environment Template
# Copy to .env.local and adjust if needed. NEVER commit real secrets.
# Local frontend runs on Mock Data by default; staging/production must use live mode.
#
# Backend integration (apps/api, FastAPI 1.0.3) includes vehicle, Agent, RAG,
# AIGC, diagnosis, garage, preferences, feedback and Admin APIs.
#   CORS already allows http://localhost:3000 by default.

# mock | live
# live = every API Service Layer call hits the FastAPI backend.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the FastAPI backend (only used when mode=live)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public app metadata - safe to expose
NEXT_PUBLIC_APP_NAME=AutoMind
NEXT_PUBLIC_APP_TAGLINE=Production Automotive AI Cockpit Platform
